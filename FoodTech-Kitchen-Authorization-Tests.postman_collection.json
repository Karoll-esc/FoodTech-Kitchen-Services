									"",
									"console.log(\"✅ SUCCESS: Bar staff correctly denied access to COLD_KITCHEN\");"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{bar_staff_token}}",
