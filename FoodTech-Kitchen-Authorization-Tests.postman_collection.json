		{
			"name": "Authorization Tests - Bar Staff",
			"item": [
				{
					"name": "✅ Bar Staff - Update BAR Task (SHOULD SUCCEED)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Task status updated to IN_PREPARATION\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(\"IN_PREPARATION\");",
									"});",
									"",
									"console.log(\"✅ SUCCESS: Bar staff can update BAR tasks\");"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{bar_staff_token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{api_base_url}}/api/tasks/{{bar_task_id}}/start",
							"host": [
								"{{api_base_url}}"
							],
							"path": [
								"api",
								"tasks",
								"{{bar_task_id}}",
								"start"
							]
						},
						"description": "Bar staff updating a BAR station task - SHOULD SUCCEED (200 OK)"
					},
					"response": []
				},
				{
					"name": "❌ Bar Staff - Update HOT_KITCHEN Task (SHOULD FAIL)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 403 Forbidden\", function () {",
									"    pm.response.to.have.status(403);",
									"});",
									"",
									"pm.test(\"Error message indicates authorization failure\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.include(\"not authorized\");",
									"    pm.expect(jsonData.message).to.include(\"HOT_KITCHEN\");",
									"});",
									"",
									"console.log(\"✅ SUCCESS: Bar staff correctly denied access to HOT_KITCHEN\");"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{bar_staff_token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{api_base_url}}/api/tasks/{{hot_kitchen_task_id}}/start",
							"host": [
								"{{api_base_url}}"
							],
							"path": [
