									"});",
									"",
									"pm.test(\"Table status is AVAILABLE\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(\"AVAILABLE\");",
									"});",
									"",
									"pm.test(\"Table has currentOrderId\", function () {",
									"    var jsonData = pm.response.json();",
