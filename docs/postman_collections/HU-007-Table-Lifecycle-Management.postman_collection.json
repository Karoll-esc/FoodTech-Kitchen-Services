		{
			"name": "Error Scenarios",
			"item": [
				{
					"name": "Invalid Transition - Skip State",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 409 Conflict\", function () {",
									"    pm.response.to.have.status(409);",
									"});",
									"",
									"pm.test(\"Error message mentions invalid transition\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.error).to.include(\"transition\");",
									"});",
									"",
									"pm.test(\"Response includes valid transitions\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.include(\"Valid transitions\");",
									"});"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// First set table to AVAILABLE",
									"const setAvailable = {",
									"  url: pm.environment.get(\"base_url\") + '/api/tables/' + pm.environment.get(\"table_id\") + '/status',",
									"  method: 'PATCH',",
									"  header: {",
									"    'Content-Type': 'application/json',",
									"    'Authorization': 'Bearer ' + pm.environment.get(\"waiter_token\")",
									"  },",
									"  body: {",
									"    mode: 'raw',",
									"    raw: JSON.stringify({ newStatus: \"AVAILABLE\" })",
									"  }",
									"};",
									"",
									"pm.sendRequest(setAvailable, function (err, response) {",
									"    console.log('Table set to AVAILABLE');;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{waiter_token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"newStatus\": \"SERVED\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/tables/{{table_id}}/status",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"tables",
								"{{table_id}}",
								"status"
							]
						},
						"description": "Try to skip from AVAILABLE to SERVED (must go through OCCUPIED first). Should return 409 Conflict."
					},
					"response": []
				},
				{
					"name": "OCCUPIED Without Order",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 400 Bad Request\", function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"",
									"pm.test(\"Error message mentions order required\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.include(\"order\");",
									"});",
									"",
									"pm.test(\"Error provides guidance\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.include(\"assign an order\");",
									"});"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// First set table to AVAILABLE (which clears order)",
									"const setAvailable = {",
									"  url: pm.environment.get(\"base_url\") + '/api/tables/' + pm.environment.get(\"table_id\") + '/status',",
									"  method: 'PATCH',",
									"  header: {",
									"    'Content-Type': 'application/json',",
									"    'Authorization': 'Bearer ' + pm.environment.get(\"waiter_token\")",
									"  },",
									"  body: {",
									"    mode: 'raw',",
									"    raw: JSON.stringify({ newStatus: \"AVAILABLE\" })",
									"  }",
									"};",
									"",
									"pm.sendRequest(setAvailable, function (err, response) {",
									"    console.log('Table set to AVAILABLE (order cleared)');;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{waiter_token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"newStatus\": \"OCCUPIED\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/tables/{{table_id}}/status",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"tables",
								"{{table_id}}",
								"status"
							]
						},
						"description": "Try to mark table as OCCUPIED without an active order. Should return 400 Bad Request."
					},
					"response": []
				},
