{
	"info": {
		"_postman_id": "hu-007-table-lifecycle",
		"name": "HU-007: Table Lifecycle Management",
		"description": "Collection for testing table status updates (AVAILABLE → OCCUPIED → SERVED → CLEANING → AVAILABLE)\n\n**Prerequisites:**\n- Set environment variables: `base_url`, `waiter_token`, `admin_token`\n- Ensure Auth0 is configured with `update:tables` permission\n- Create a table first using the Create Table endpoint",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Setup - Create Test Table",
			"item": [
				{
					"name": "Create Table A1",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response has table ID\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.id).to.be.a('number');",
									"    pm.environment.set(\"table_id\", jsonData.id);",
									"});",
									"",
									"pm.test(\"Table status is AVAILABLE\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(\"AVAILABLE\");",
									"});",
									"",
									"pm.test(\"lastStateChangeAt is set\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.lastStateChangeAt).to.exist;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{admin_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tableNumber\": \"A1\",\n  \"capacity\": 4\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/tables",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"tables"
							]
						},
						"description": "Create a test table that will be used for lifecycle testing. Requires admin:all permission."
					},
					"response": []
				},
				{
					"name": "Create Order for Table (Manual)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response has order tasks\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.tasksCreated).to.be.above(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{waiter_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tableNumber\": \"A1\",\n  \"products\": [\n    {\n      \"name\": \"Coca Cola\",\n      \"type\": \"DRINK\"\n    },\n    {\n      \"name\": \"Hamburguesa\",\n      \"type\": \"HOT_DISH\"\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/orders",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"orders"
							]
						},
						"description": "Create an order for the table so it can be marked as OCCUPIED. This step is REQUIRED before changing status to OCCUPIED."
					},
					"response": []
				}
			],
			"description": "Setup endpoints to create test data"
		},
		{
			"name": "Happy Path - Complete Lifecycle",
