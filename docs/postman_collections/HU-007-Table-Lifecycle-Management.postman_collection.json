								{
									"key": "token",
									"value": "{{waiter_token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"newStatus\": null\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/tables/{{table_id}}/status",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"tables",
								"{{table_id}}",
								"status"
